// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Generate Protobuf [Server]",
    "command": "protoc",
    "args": ["-I=core", "--go_out=core", "core/*.proto"],
    "save": "all",
    "shell": "system",
    "show_summary": true,
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "hide": "on_success",
    "tags": ["proto"],
  },
  {
    "label": "Generate Protobuf [Client]",
    "command": "D:\\Godot\\Godot_v4.6.2-stable_win64.exe",
    "args": [
      "--headless",
      "-q",
      "-s",
      "addons/godobuf/godobuf_cmdln.gd",
      "--input=\"${ZED_WORKTREE_ROOT}/core/packets.proto\"",
      "--output=\"src/common/network/packets/packets.gd\"",
    ],
    "cwd": "${ZED_WORKTREE_ROOT}/client",
    "save": "none",
    "shell": "system",
    "show_summary": true,
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never",
    "hide": "on_success",
    "tags": ["proto"],
  },
  {
    "label": "Generate SQLC Bindings",
    "command": "sqlc",
    "args": [
      "generate",
      "-f ${ZED_WORKTREE_ROOT}/core/internal/db/config/sqlc.yaml",
    ],
    "save": "none",
    "shell": "system",
    "show_summary": true,
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never",
    "hide": "on_success",
    "tags": ["sqlc"],
  },
]
