// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "Delve",
    "label": "Turntide Server (Delve)",
    "request": "launch",
    "mode": "debug",
    "program": "./server",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "args": ["--", "-db-path", "./shared/resources/server.db"],
    "env": {},
  },
  {
    "adapter": "Delve",
    "label": "Turntide Server Tests (Delve)",
    "request": "launch",
    "mode": "test",
    "program": ".",
    "args": ["-test.v", "-test.run=${ZED_SYMBOL}"],
    "cwd": "${ZED_WORKTREE_ROOT}/server/test",
    "env": {},
  },
]
